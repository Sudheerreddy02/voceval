# Copy to .env and fill in the providers you have. voceval runs fully offline
# with mock providers when these are unset, so CI and local dev need nothing.

# --- LLM ---
OPENAI_API_KEY=
VOCEVAL_LLM_MODEL=gpt-4o-mini

# --- Speech-to-text ---
DEEPGRAM_API_KEY=
VOCEVAL_STT_MODEL=nova-2

# --- Text-to-speech (pick one) ---
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
VOCEVAL_TTS_VOICE=

# --- Telephony (optional, for the Twilio Media Streams transport) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Runtime defaults ---
VOCEVAL_PROVIDER_PROFILE=mock   # mock | live
VOCEVAL_SAMPLE_RATE=16000
