# Copy to .env and fill in the providers you have. voceval runs fully offline
# with mock providers when these are unset, so CI and local dev need nothing.
# In the live profile each stage is live if its key is set and mocked otherwise.

VOCEVAL_PROVIDER_PROFILE=mock   # mock | live

# --- LLM (OpenAI API or anything OpenAI-compatible) ---
# OpenAI: leave OPENAI_BASE_URL empty, use e.g. gpt-4o-mini.
# Groq (free tier): OPENAI_API_KEY=<groq key>, base url below, model openai/gpt-oss-20b.
OPENAI_API_KEY=
OPENAI_BASE_URL=
VOCEVAL_LLM_MODEL=gpt-4o-mini

# --- Speech-to-text (Deepgram, used by the phone and mic transports) ---
DEEPGRAM_API_KEY=
VOCEVAL_STT_MODEL=nova-3

# --- Text-to-speech (Cartesia is preferred when both are set) ---
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
VOCEVAL_TTS_VOICE=

# --- Telephony (optional, for the Twilio Media Streams transport) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Runtime ---
VOCEVAL_SAMPLE_RATE=16000
VOCEVAL_TIME_SCALE=1.0          # <1 runs mock sims faster than real time
